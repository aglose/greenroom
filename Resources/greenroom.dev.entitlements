<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Ad hoc builds only (scripts/bundle.sh with --identity -): an ad hoc signature has no team, so library validation
     would refuse the app's own Sparkle.framework. Builds signed with a real identity have no entitlements at all. -->
<dict>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
